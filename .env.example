# Server
PORT=8080
CORS_ORIGINS=http://localhost:5173

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ekokan?sslmode=disable

# Storage backend: "fs" or "s3"
STORAGE_BACKEND=fs
STORAGE_FS_ROOT=./data/media

# S3 configuration (only needed if STORAGE_BACKEND=s3)
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=

MEDIA_BASE_URL=

# Authentication & Registration
JWT_SECRET=super-secret-ekokan-jwt-key
ALLOW_PUBLIC_REGISTRATION=true

